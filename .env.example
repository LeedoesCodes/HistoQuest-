# Copy this file to `.env.local` and fill in your Supabase project values.
# Get these from Supabase → Project Settings → API.
# While these are blank/absent, the app runs in offline-mock mode and
# buffers behavior logs in the browser (IndexedDB) instead of the cloud.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
