{
  "name": "basaquest-history",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BasaQuest — History module (gamified Philippine & Davao local history for Grade 5). React + Phaser + Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
