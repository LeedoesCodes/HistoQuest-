    "test:mactan:formation": "node scripts/verify_mactan_formation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "phaser": "^3.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
